# Package Manager: "npm", "yarn", or "both"
PACKAGE_MANAGER=npm

# npm registries (optional overrides; defaults in .npmrc)
# NPM_REGISTRY=https://registry.npmjs.org/
# WM_NPM_REGISTRY=https://repository.wavemaker.com/repository/wavemaker-npm-repo/

# WaveMaker Studio Credentials
WM_USERNAME=your_email@wavemaker.com
WM_PASSWORD=your_password

# WaveMaker Project Configuration
WM_PROJECT_ID=WMPRJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WM_ENVIRONMENT=stage
DEPLOYED_SERVER_URL=https://your-deployed-app.com/services
MOBILE_SERVER_URL=https://stage-studio.wavemakeronline.com/run-xxxxx/services

# Android Configuration
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_EMULATOR_NAME=Pixel8
LOCAL_DEVICE_NAME=emulator-5554
LOCAL_PLATFORM_VERSION=14
PLATFORM_NAME=android

# iOS Configuration (for iOS builds)
IOS_P12_CERT_PATH=/path/to/Certificates.p12
IOS_PROVISION_PROFILE_PATH=/path/to/profile.mobileprovision
IOS_P12_PASSWORD=your_password
IOS_SIMULATOR_DEVICE=iPhone 15
IOS_SIMULATOR_RUNTIME=

# BrowserStack Configuration (optional)
RUN_LOCAL=true
BROWSERSTACK_USERNAME=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_key
PROJECT_NAME=CliSanity
BS_ANDROID_DEVICE_NAME=Google Pixel 8
BS_ANDROID_PLATFORM_VERSION=14
IOS_DEVICE_NAME=iPhone 15 Plus
IOS_PLATFORM_VERSION=17

# Headless Chrome (set to true for CI/headless Linux)
HEADLESS=false

# App Configuration
APP_NAME=CliSanity
APP_PACKAGE=com.wavemaker.clisanity
APP_ACTIVITY=.MainActivity
APP_VERIFICATION_ID=~mobile_navbar1_title
# Optional fallback when accessibility id is not exposed on the landing page
# APP_VERIFICATION_TEXT=Component Gallery
# Web preview verification (stage-ai example):
# WEB_PREVIEW_XPATH=//div[@aria-label='page_title_label_caption']
# WEB_PREVIEW_TITLE=MainPage

# RN ZIP download for app-build (RnProjectManager: build → poll jobs → download → extract)
# STUDIO_PROJECT_ID=proj-xxxxxxxx   # jobs API: GET .../jobs/project/{STUDIO_PROJECT_ID}
#   Reads metadata.nativeMobileZipId from each NATIVE_MOBILE_ZIP job
# RN_BUILD_EMPTY_JOBS_POLL_LIMIT=12   # abort build poll after N empty job responses (~60s)
# RN_SKIP_STUDIO_BUILD=true           # skip new build; use jobs API + RN_ZIP_DOWNLOAD_URL only
# RN_ZIP_DOWNLOAD_URL=49ca1211668a44feb770620b5a8d936a
#   Last-resort fallback file id or file-service URL if build + jobs lookup fail
# RN_DOWNLOAD_FROM_STUDIO=false     # opt out; use pre-placed src/rn-zips/<RN_PROJECT_FOLDER>
# RN_PROJECT_FOLDER=CliSanity-native-mobile_0.0.1

# Studio Configuration
# PREVIEW_URL_MAX_RETRIES=3
# PREVIEW_URL_RETRY_DELAY_MS=15000
# SYNC_TIMEOUT=900000
# STUDIO_URL selects the CLI variant (auto-detected). LOGIN_URL defaults to STUDIO_URL/login/authenticate.
#   Classic (wm-reactnative):    *studio.wavemakeronline.com
#   AI      (wm-reactnative-ai): *platform.wavemaker.ai
LOGIN_URL=https://stage-studio.wavemakeronline.com/login/authenticate
STUDIO_URL=https://stage-studio.wavemakeronline.com
# STUDIO_URL=https://stage-platform.wavemaker.ai
# LOGIN_URL=https://stage-platform.wavemaker.ai/login/authenticate

# S3 Report Upload (optional)
S3_REPORT_BUCKET=
S3_REPORT_VERSION=WM-AI 1.0.0_BETA_RC4
S3_REPORT_PROJECT=Cli
S3_REPORT_FILENAME=devstudio-cli.html
# Security scan — separate Studio account + project (not WM_USERNAME / WM_PROJECT_ID):
# SECURITY_USERNAME=security_studio_user@wavemaker.com
# SECURITY_PASSWORD=your_security_studio_password
# SECURITY_PROJECT_ID=WMPRJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SECURITY_STUDIO_PROJECT_ID=proj-xxxxxxxx
# SECURITY_STUDIO_URL=https://stage-studio.wavemakeronline.com   # or https://stage-platform.wavemaker.ai
# SECURITY_APP_NAME=StyleWorkSpaceAutomation
# SECURITY_APP_PACKAGE=com.wavemaker.styleworkspaceautomation
# Jenkins: SECURITY_WM_USERNAME, SECURITY_WM_PASSWORD, SECURITY_WM_PROJECT_ID,
#          SECURITY_WM_STUDIO_URL, SECURITY_WM_STUDIO_PROJECT_ID
# S3: react_native/releases/<S3_VERSION>/Security Vulnerabilities/security-vulnerabilities.html
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Security vulnerabilities scan (SecurityVulnerabilities branch CLI fork — independent of CLI sanity tests)
# Run: ./scripts/run-security-vulnerabilities.sh [branch]
#   or: ./run-cli-tests.sh SecurityVulnerabilities npm security
# Jenkins All Tests: CLI suite (wavemaker repo) → then security scan (Karthik fork at wm-reactnative-cli-security/)
# Clone: git clone -b SecurityVulnerabilities https://github.com/Karthik7bk/wm-reactnative-cli.git
# Local clone path: ./wm-reactnative-cli-security (clean reset on every run)
# S3: react_native/releases/<S3_REPORT_VERSION>/Security Vulnerabilities/security-vulnerabilities.html
# SECURITY_CLI_BINARY=wm-reactnative
# SECURITY_CLI_REPO_URL=https://github.com/Karthik7bk/wm-reactnative-cli.git
# SECURITY_CLI_BRANCH=SecurityVulnerabilities
# SNYK_TOKEN=your_snyk_api_token
# Jenkins: add Secret text credential ID SNYK_TOKEN (see Jenkinsfile environment block)
# SECURITY_FAIL_ON_VULN=false
# SKIP_SECURITY_SCAN=false
# SECURITY_SCAN_TIMEOUT=2700000